PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/codepulse
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-token-encryption-key
OAUTH_STATE_SECRET=replace-with-a-long-random-oauth-state-secret
SESSION_SECRET=replace-with-a-session-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=30000
AI_PROVIDER=gemini
